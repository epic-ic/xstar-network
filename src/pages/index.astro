---
const base = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>xSTAR</title>
	</head>
	<body>
		<main>
			<h1>xSTAR</h1>
			<p>The new xSTAR website is being built here. Until it's ready, the current site is at <a href="https://www.404-website-not-exist-xstar-network.org/">www.xstar-network.org</a>.</p>
		</main>
	</body>
</html>
