{
  "name": "xstar-network",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:links": "astro build --outDir _site/xstar-network && linkinator xstar-network --server-root _site --recurse",
    "check:accessibility": "astro build && playwright test",
    "check:types": "astro check",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "astro": "7.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "linkinator": "8.1.0",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
